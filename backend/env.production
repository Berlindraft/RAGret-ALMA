# Used when APP_ENV=production (see README). In Docker Compose, variables are injected instead.
HOST=0.0.0.0
PORT=3005

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=your-db-host.example.com
POSTGRES_PORT=5432
POSTGRES_DB=app

# Optional: set this instead of POSTGRES_* when your platform provides a single URL
# DATABASE_URL=postgres://user:CHANGE_ME@your-db-host.example.com:5432/app
